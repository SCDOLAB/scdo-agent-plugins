{
  "name": "@scdo/plugin-eliza",
  "version": "0.3.2",
  "description": "SCDO x402 wallet plugin for ElizaOS: the agent gets its own USDC wallet on Base (key generated locally), pays x402 URLs and books signed rows on the SCDO x402 Agent Ledger.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://scdo.com.au/agent/",
  "keywords": [
    "elizaos",
    "eliza",
    "plugin",
    "x402",
    "wallet",
    "usdc",
    "base",
    "scdo"
  ],
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepack": "cp ../mcp/src/core.js src/scdo-core.js"
  },
  "dependencies": {},
  "peerDependencies": {
    "@elizaos/core": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@elizaos/core": {
      "optional": true
    }
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "SCDO_AGENT_BOT": {
        "type": "string",
        "description": "Local agent name (default: character name)"
      },
      "SCDO_AGENT_NETWORK": {
        "type": "string",
        "description": "base (mainnet, default) or base-sepolia (testnet)"
      },
      "SCDO_AGENT_DATA": {
        "type": "string",
        "description": "scdo-agent data dir"
      },
      "SCDO_AGENT_AUTOSTART": {
        "type": "string",
        "description": "Register, start heartbeats and create the wallet on start (default true)"
      },
      "SCDO_AGENT_NO_DOWNLOAD": {
        "type": "string",
        "description": "Set to 1 to not auto-download the scdo-agent CLI (Linux) into ~/.scdo-agent/bin"
      }
    }
  },
  "devDependencies": {
    "scdo-agent-mcp": "file:../mcp"
  }
}
