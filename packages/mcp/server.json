{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SCDOLAB/scdo-agent-mcp",
  "description": "SCDO chain, Agent Ledger and x402 tools. stdio via npm, or Streamable HTTP at https://scdo.com.au/mcp once the site proxy is in place.",
  "repository": {
    "url": "https://github.com/SCDOLAB/scdo-agent-plugins",
    "source": "github",
    "subfolder": "packages/mcp"
  },
  "websiteUrl": "https://scdo.com.au/linux-agent/",
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "scdo-agent-mcp",
      "version": "0.2.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SCDO_AGENT_NETWORK",
          "description": "base (default) or base-sepolia",
          "isRequired": false
        },
        {
          "name": "SCDO_AGENT_DATA",
          "description": "scdo-agent data dir",
          "isRequired": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://scdo.com.au/mcp"
    }
  ]
}
