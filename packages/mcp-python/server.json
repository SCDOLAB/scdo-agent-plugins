{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SCDOLAB/scdo-agent-mcp",
  "description": "SCDO agent wallets: x402 USDC on Base, Agent Ledger, bulk onboarding, chain tools.",
  "repository": {
    "url": "https://github.com/SCDOLAB/scdo-agent-plugins",
    "source": "github",
    "subfolder": "packages/mcp-python"
  },
  "websiteUrl": "https://scdo.com.au/agent/",
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "scdo-agent-mcp",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SCDO_AGENT_NETWORK",
          "description": "base (default) or base-sepolia",
          "isRequired": false
        },
        {
          "name": "SCDO_AGENT_DATA",
          "description": "scdo-agent data dir",
          "isRequired": false
        }
      ]
    },
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "scdo-agent-mcp",
      "version": "0.2.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SCDO_AGENT_NETWORK",
          "description": "base (default) or base-sepolia",
          "isRequired": false
        },
        {
          "name": "SCDO_AGENT_DATA",
          "description": "scdo-agent data dir",
          "isRequired": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://scdo.com.au/mcp"
    }
  ]
}
